# Copy this file to .env.local and fill the values from your own test apps.
# Never commit .env.local, client secrets, session secrets, or repository names.
ORBIT_APP_URL=http://localhost:3000
ORBIT_SESSION_SECRET=replace-with-a-long-random-local-secret
# Separate key for AES-256-GCM encryption of provider tokens in PostgreSQL.
ORBIT_TOKEN_ENCRYPTION_SECRET=replace-with-a-different-long-random-local-secret

# Required whenever provider connections are enabled. ORBIT stores only opaque
# sessions and encrypted provider tokens here; tracking records remain in Git.
# Local Compose default: postgresql://orbit:orbit-local-only@127.0.0.1:54329/orbit
DATABASE_URL=

# GitLab OAuth application
ORBIT_GITLAB_BASE_URL=https://gitlab.com
ORBIT_GITLAB_CLIENT_ID=
ORBIT_GITLAB_CLIENT_SECRET=

# GitHub App user-to-server authorization
ORBIT_GITHUB_APP_CLIENT_ID=
ORBIT_GITHUB_APP_CLIENT_SECRET=

# Deployment-owned authorization boundary; not read from project manifests.
ORBIT_ALLOWED_PROJECTS=gitlab:example-group/example-project,github:example-owner/example-project
ORBIT_TRACKING_PATH=.local.docs/project-tracking
